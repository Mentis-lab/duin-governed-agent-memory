# Matches .prettierrc (2-space, printWidth 100, no semicolons, single quotes).
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{cmd,bat,ps1}]
end_of_line = crlf

[Makefile]
indent_style = tab
