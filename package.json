{
  "name": "duin",
  "productName": "DUIN",
  "version": "0.2.0",
  "description": "Agents that earn your trust: a harness that keeps an agent's long-term memory, model of your world and permissions as Markdown you own, governed at every step. Facts labelled by who said them and proven before believed; your word never revised by a model; autonomy granted by you.",
  "main": "./out/main/index.js",
  "bin": {
    "duin": "./out/main/cli.js"
  },
  "author": {
    "name": "Mentis-lab",
    "url": "https://github.com/Mentis-lab"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mentis-lab/duin-governed-agent-memory.git"
  },
  "homepage": "https://github.com/Mentis-lab/duin-governed-agent-memory",
  "bugs": {
    "url": "https://github.com/Mentis-lab/duin-governed-agent-memory/issues"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "setup": "npm ci --ignore-scripts && node node_modules/electron/install.js",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "docs:handbook": "node scripts/gen-harness-handbook.mjs",
    "prepare:models": "node scripts/prepare-bundled-models.mjs",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "lint:cohesion": "node scripts/cohesion-lint.mjs",
    "lint:lanes": "node scripts/lane-lint.mjs",
    "lint:orientation": "node scripts/lint-orientation.mjs",
    "lint:language-parity": "node scripts/language-parity-lint.mjs",
    "lint:reachability": "node scripts/reachability-lint.mjs",
    "lint:preload-surface": "node scripts/preload-surface-lint.mjs",
    "lint:unsupplied-input": "node scripts/unsupplied-input-lint.mjs",
    "lint:bundle-safety": "node scripts/bundle-safety-lint.mjs",
    "lint:loop-liveness": "node scripts/loop-liveness-lint.mjs",
    "hooks:install": "git config core.hooksPath scripts/hooks",
    "hooks:uninstall": "git config --unset core.hooksPath",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench:agent": "vitest run agent-bench",
    "bench:live": "node bench/live-eval/run.mjs",
    "verify:proof": "node scripts/verify-proof.cjs",
    "verify:all": "npm run build && node scripts/verify-proof.cjs --require-smokes",
    "smoke:bundle": "node scripts/smoke-bundle.cjs",
    "smoke:renderer": "node scripts/smoke-renderer.cjs",
    "lamprey": "electron-vite dev -- --lamprey-headless",
    "duin": "electron-vite dev -- --lamprey-headless",
    "build:prepare": "node scripts/gen-third-party-notices.mjs && node scripts/fetch-bundled-models.mjs && node scripts/stage-models-for-release.mjs && node scripts/stage-dsh-runtime.mjs && npm run build",
    "build:win": "npm run build:prepare && electron-builder --win --publish never",
    "build:mac": "npm run build:prepare && electron-builder --mac --publish never",
    "build:linux": "npm run build:prepare && electron-builder --linux --publish never",
    "lint:signal": "node scripts/signal-lint.mjs",
    "lane:close": "node scripts/lane-close.mjs",
    "test:teeth": "node --test \"scripts/*.test.mjs\" \"resources/mcp/*/*.test.mjs\"",
    "icons:mac": "node scripts/make-mac-icon.mjs",
    "i18n:extract": "node scripts/extract-ui-strings.mjs"
  },
  "dependencies": {
    "@babel/standalone": "^7.29.7",
    "@base-ui/react": "^1.6.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.4",
    "@cosmos.gl/graph": "^3.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@huggingface/transformers": "^3.8.1",
    "@larksuiteoapi/node-sdk": "^1.73.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@napi-rs/canvas": "0.1.80",
    "@slack/socket-mode": "^3.0.0",
    "@slack/web-api": "^8.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.11.2",
    "better-sqlite3": "^13.0.1",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "grapesjs": "^0.23.2",
    "gray-matter": "^4.0.3",
    "imapflow": "^1.7.6",
    "js-yaml": "^4.1.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.15.0",
    "node-html-parser": "^7.1.0",
    "nodemailer": "^9.0.5",
    "officeparser": "^7.2.3",
    "openai": "^6.39.1",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.1.200",
    "pptxgenjs": "^4.0.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "shiki": "^4.1.0",
    "sonner": "^2.0.7",
    "sqlite-vec": "^0.1.9",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.8",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-rebuild": "^3.2.9",
    "electron-updater": "^6.8.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.4.1",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.5.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.8.3",
    "rcedit": "^5.0.2",
    "tailwindcss": "^4.3.0",
    "typescript": "5.7",
    "vitest": "^4.1.7"
  }
}
